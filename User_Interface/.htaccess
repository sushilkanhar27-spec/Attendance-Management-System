# Friendly Apache error screens for the XAMPP project URL.
ErrorDocument 400 /AMSproject/error.php?code=400
ErrorDocument 403 /AMSproject/error.php?code=403
ErrorDocument 404 /AMSproject/error.php?code=404
ErrorDocument 500 /AMSproject/error.php?code=500
ErrorDocument 502 /AMSproject/error.php?code=502
ErrorDocument 503 /AMSproject/error.php?code=503