  "cards": [
    {
      "dot": "cyan",
      "title": "Role portals and attendance",
      "items": [
        "index.php authenticates Admin, Teacher, and Student; role pages are Teacher.php, Student.php, and admin_dashboard.php.",
        "Teacher.php uses fetch_attendance.php and save_attendance.php; Student.php displays records using get_attendance.php.",
        "Frontend assets include index.css, Teacher.css, Student1.css, Student.js, and admin_dashboard.css.",
        "attendance_functions.php applies active semester and holiday date rules; semester_settings.php and holidays.php manage those settings."
      ]
    },
    {
      "dot": "emerald",
      "title": "Admin data and exports",
      "items": [
        "Management pages present: manage_students1.php, manage_teachers.php, manage_departments.php, and admin_manage_attendance.php.",
        "reports.php is present. Download handlers present: download_excel.php, download_student_excel.php, download_student_attendance.php, and admin_download_attendance.php.",
        "PHP queries use students, teacher, admin, departments, attendance_record, semester_settings, and holidays; db_connect.php selects the MySQL database."
      ]
    },
    {
      "dot": "violet",
      "title": "Biometric evidence and limits",
      "items": [
        "AS608 is named in add_biometric.php; PHP comments identify an ESP8266 device and an OLED-ready result in biometric_attendance.php.",
        "biometric_attendance.php receives GET device_id/fingerprint_id and returns JSON; the ESP8266 polls enrollment endpoints and submits completion by POST.",
        "Device endpoints present: biometric_attendance.php, biometric_attendance_control.php, biometric_get_request.php, and biometric_complete_enrollment.php.",
        "Biometric tables referenced: biometric_devices, biometric_attendance_control, biometric_enrollment_requests, and student_biometrics; attendance is written to attendance_record.",
        "No standalone SQL schema, ESP8266 firmware, or OLED source file appears in the project inventory."
      ]
    }
  ]
